rules_version = '2';

// ===============================================================
// InteractUp Firestore Security Rules (Backend-Only Access Model)
// ===============================================================
//
// All public and authenticated portal data is served through the
// Vercel backend API (/api/public-data, /api/portal-data,
// /api/admin-save, /api/member-action) using Firebase Admin SDK.
//
// Direct client-side reads and writes to Firestore are blocked so
// visitors cannot inspect private member emails, demerits,
// warnings, peer ratings, or offer letter requests via DevTools.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
